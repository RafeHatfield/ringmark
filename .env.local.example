# Supabase — get these from your project dashboard at app.supabase.com
# Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  # server-side only, NEVER expose to client

# App URL — used for QR code generation
# Development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production (set this in Vercel env vars before generating any QR codes you intend to print):
# NEXT_PUBLIC_APP_URL=https://ringmark.org
